// the only approach as we see here is that we have precedances in operator * and /. so these needs to be handled first and
// later add what we have pushed into the stack.
// one more trick is whenever we see '-' we push the upcoming digit with -(num)
// so TC is O(n) 2 separate single passes SC is O(n) which is for stack.
class Solution {
    public int calculate(String s) {
        int num=0;
        char sign='+';
        Stack<Integer> stack=new Stack<>();
        for(char c:s.toCharArray()){
            if(Character.isDigit(c)){
                num= num * 10 +(c - '0');
            }else if(c != ' '){
                if(sign == '+')
                stack.push(num);
                else if(sign == '-')
                stack.push(-num);
                else if(sign == '*')
                stack.push(stack.pop() *num);
                else if(sign == '/')
                stack.push(stack.pop() /num);
                
                sign=c;
                num=0;
            }
        }

        if(sign == '+')
        stack.push(num);
        else if(sign == '-')
        stack.push(-num);
        else if(sign == '*')
        stack.push(stack.pop() *num);
        else if(sign == '/')
        stack.push(stack.pop() /num);
                
        
        num=0;
        while(!stack.isEmpty())
        num+= stack.pop();

        return num; 
    }
}
