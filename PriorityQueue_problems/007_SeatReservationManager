// this is a simple PriorityQueue to have a SeatReservation System
// TC is O(n logn) during the insertion, otherwise reserve and unreserver works with O(log n)
// SC is O(n)
class SeatManager {
    Queue<Integer> reservationQueue;
    public SeatManager(int n) {
        this.reservationQueue = new PriorityQueue<>();
        for(int i=1;i<=n;i++)
            reservationQueue.offer(i);
        
    }
    
    public int reserve() {
        return reservationQueue.poll();
    }
    
    public void unreserve(int seatNumber) {
        reservationQueue.offer(seatNumber);
    }
}

