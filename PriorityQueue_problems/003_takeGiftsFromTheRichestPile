// optimal approach here is best because the problem statement directly
// says that we need to sqrt each maximum.
// TC is O(n logn + k logn)
// SC is O(n)

class Solution {
    public long pickGifts(int[] gifts, int k) {

        Queue<Integer> pq=new PriorityQueue(Comparator.reverseOrder());
        for(int gift: gifts){
            pq.offer(gift);
        }

        for(int i=0;i<k;i++){
         pq.offer((int)Math.sqrt(pq.poll()));   
        }

        long result=0;
        while(!pq.isEmpty()){
            result+=pq.poll();
        }
        return result;
    }
}
