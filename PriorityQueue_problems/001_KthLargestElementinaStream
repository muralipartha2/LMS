class KthLargest {
    PriorityQueue<Integer> pq;
    int heapSize;
    public KthLargest(int k, int[] nums) {
        this.heapSize=k;
        pq=new PriorityQueue();
        for(int num: nums){
            add(num);
        }
    }
    
    public int add(int val) {
        if(pq.size() < heapSize){
            pq.offer(val);
        }else if(val > pq.peek()){
            pq.poll();
            pq.offer(val);
        }

        return pq.peek();
    }
}

