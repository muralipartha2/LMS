// Naive approach with Arrays.sort to have the minimal first itself
// TC is O(n log n)
// SC is O(1)
class Solution {
    public int[][] kClosest(int[][] points, int k) {

        int[][] result= new int[k][2];

        Arrays.sort(points,(a,b) -> {
                        int disA=(int) (Math.pow(a[0],2) + Math.pow(a[1],2));
                                    int disB=(int) (Math.pow(b[0],2) + Math.pow(b[1],2));
                                                return Integer.compare(disA,disB);
                                                        });
       
       int resultIndex=0;
        for(int i=0;i<k;i++){
            result[resultIndex++]=points[i];
        }
        
        return result;
    }
}


// optimal approach using maxheap
// to maintain always the lowest arr[] in that
//TC is O(n log k)
// SC is O(k)
class Solution {
    public int[][] kClosest(int[][] points, int k) {

        int[][] result= new int[k][2];

        Queue<int[]> pq=new PriorityQueue<>((a,b) -> {
            int disA=(int) (Math.pow(a[0],2) + Math.pow(a[1],2));
            int disB=(int) (Math.pow(b[0],2) + Math.pow(b[1],2));
            return Integer.compare(disB,disA);
        });

        for(int i=0;i<points.length;i++){
            pq.offer(points[i]);
            if(pq.size() > k){
                    pq.poll();
                }
            
        }
        int resultIndex=0;
        while(!pq.isEmpty()){
            result[resultIndex++]=pq.poll();
        }
        
        return result;
    }
}
