//https://leetcode.com/problems/range-sum-query-2d-immutable/
class NumMatrix {
    private int[][] prefix; // 2D prefix sum matrix

    // Constructor: preprocess the matrix
    public NumMatrix(int[][] matrix) {
        if (matrix.length == 0 || matrix[0].length == 0) {
            return; // handle empty matrix
        }
        int m = matrix.length;
        int n = matrix[0].length;
        prefix = new int[m + 1][n + 1]; 
        // +1 padding to avoid index out-of-bound when subtracting

        // Build prefix matrix
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {
                prefix[i][j] = matrix[i - 1][j - 1] 
                             + prefix[i - 1][j] 
                             + prefix[i][j - 1] 
                             - prefix[i - 1][j - 1];
            }
        }
    }

    // Query: sum of rectangle (r1,c1) to (r2,c2)
    public int sumRegion(int r1, int c1, int r2, int c2) {
        // shift by +1 because of padding
        int row1 = r1 + 1, col1 = c1 + 1;
        int row2 = r2 + 1, col2 = c2 + 1;

        return prefix[row2][col2] 
             - prefix[row1 - 1][col2] 
             - prefix[row2][col1 - 1] 
             + prefix[row1 - 1][col1 - 1];
    }
}
