//https://leetcode.com/problems/maximum-sum-of-distinct-subarrays-with-length-k/

// brute force solution is there to O(n^2)


//optimal solution
// instead of having hashmap, we can have array also but we need to have 
// one more flag to check whether the distinc count == window size k.
class Solution {
    public long maximumSubarraySum(int[] nums, int k) {

        int n=nums.length;
        Map<Integer,Integer> map=new HashMap<>();
        long subArrSum=0;
        for(int i=0;i<k;i++){
            subArrSum+= nums[i];
            map.put(nums[i],map.getOrDefault(nums[i],0)+1);
        }
        long maxSum=0;
        if(map.size() == k)
            maxSum=subArrSum;

        for(int i=k;i<n;i++){
            subArrSum= subArrSum + nums[i] - nums[i-k];
            
            map.put(nums[i],map.getOrDefault(nums[i],0)+1);

            map.put(nums[i-k], map.get(nums[i-k]) - 1);
            if(map.get(nums[i-k]) == 0)
                map.remove(nums[i-k]);
            
            if(map.size() == k)
                maxSum=Math.max(subArrSum, maxSum);
        }

        return maxSum;
    }
}
