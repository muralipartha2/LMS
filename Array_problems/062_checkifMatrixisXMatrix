//https://leetcode.com/problems/check-if-matrix-is-x-matrix/description/

//single pass solution and this is the optimal solution too.
// we have iterate each and check the logic.
class Solution {
    public boolean checkXMatrix(int[][] grid) {
        int row = grid[0].length - 1;

        for (int i = 0; i < grid[0].length; i++) {
            for (int j = 0; j < grid[0].length; j++) {
                if (((i == j) || (i + j == row))) {
                    if (grid[i][j] == 0)
                        return false;
                } else {
                    if (grid[i][j] != 0)
                        return false;
                }
            }
        }
        return true;
    }
}
