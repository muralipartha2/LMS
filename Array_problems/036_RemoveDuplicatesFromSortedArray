//https://leetcode.com/problems/remove-duplicates-from-sorted-array/

class Solution {
    public int removeDuplicates(int[] nums) {
        int writeIndex=1;

        if(nums.length == 1)
            return writeIndex;
        
        for(int i=1;i< nums.length;i++){
            if(nums[i] != nums[i-1]){
                nums[writeIndex]= nums[i];
                writeIndex++;
            }
        }
        return writeIndex;
    }
}
