//https://leetcode.com/problems/two-sum-ii-input-array-is-sorted/

// simple bruteforce/naive approach:
// having two loops to identify the sum between indices is equal to target.

class Solution {
    public int[] twoSum(int[] numbers, int target) {

        for(int i=0;i<numbers.length;i++){
            for(int j=i+1;j<numbers.length;j++){
                int sum=numbers[i]+numbers[j];
                if(sum == target){
                    return new int[]{i+1,j+1};
                }
            }
        }
        return new int[]{-1,-1};
        
    }
}

// optimal appproach is using two pointers approach.
// since the array is sorted and the question asks to use one constant extra space.

class Solution {
    public int[] twoSum(int[] numbers, int target) {

        int left=0,right=numbers.length-1;
        while(left < right){
            int sum= numbers[left]+ numbers[right];
            if(sum == target){
                return new int[]{left+1,right+1};
            }else if(sum > target){
                right--;
            }else{
                left++;
            }
        }

        return new int[]{-1,-1};
        
    }
}
