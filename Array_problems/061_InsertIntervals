// the naive and optimal approach.
//TC O(n) and SC O(n).

//so there are three cases here, which needs to be considered.
class Solution {
    public int[][] insert(int[][] intervals, int[] newInterval) {
        List<int[]> result=new ArrayList<>();
        boolean inserted=false;
        
        for(int i=0;i<intervals.length;i++){
            if(inserted){
                result.add(intervals[i]);
                continue;
            }
            if((newInterval[0] <= intervals[i][1]) && (newInterval[1] >= intervals[i][0])){
                newInterval[1]=Math.max(intervals[i][1],newInterval[1]);
                newInterval[0]=Math.min(intervals[i][0],newInterval[0]);
            }else if((intervals[i][0] > newInterval[1])){
                result.add(newInterval);
                inserted=true;
                result.add(intervals[i]);
            }else{
                result.add(intervals[i]);
            }
        }
        if(!inserted) result.add(newInterval);

        return result.toArray(new int[result.size()][]);
    }
}


//same solution as above
// but better readability
class Solution {
    public int[][] insert(int[][] intervals, int[] newInterval) {
        List<int[]> result = new ArrayList<>();
        int i = 0;
        int n = intervals.length;

        // Case 1 — current interval completely BEFORE newInterval
        // no overlap possible, just add current
        while(i < n && intervals[i][1] < newInterval[0]){
            result.add(intervals[i]);
            i++;
        }

        // Case 2 — overlap — keep merging
        while(i < n && intervals[i][0] <= newInterval[1]){
            newInterval[0] = Math.min(intervals[i][0], newInterval[0]);
            newInterval[1] = Math.max(intervals[i][1], newInterval[1]);
            i++;
        }
        // add merged newInterval
        result.add(newInterval);

        // Case 3 — current interval completely AFTER newInterval
        // just add remaining
        while(i < n){
            result.add(intervals[i]);
            i++;
        }

        return result.toArray(new int[result.size()][]);
    }
}
