import java.util.*;

class Solution {
    /**
     * APPROACH: BRUTE FORCE
     * 
     * Algorithm:
     * 1. Sort the pattern string p once
     * 2. For each possible window of size p.length() in string s:
     *    - Extract the substring
     *    - Sort the substring
     *    - Compare with sorted p
     *    - If they match, it's an anagram
     * 
     * Time Complexity: O(n × m log m)
     *   - n = length of s, m = length of p
     *   - We iterate through ~n windows
     *   - Each window requires sorting: O(m log m)
     * 
     * Space Complexity: O(m)
     *   - For storing sorted strings
     * 
     * Why this approach?
     *   - Simple and straightforward
     *   - Easy to understand
     *   - Works but inefficient for large inputs
     */
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> result = new ArrayList<>();
        
        // Edge case: if p is longer than s, no anagrams possible
        if (p.length() > s.length()) {
            return result;
        }
        
        // Step 1: Sort pattern p once (one-time cost)
        char[] pArray = p.toCharArray();
        Arrays.sort(pArray);
        String sortedP = new String(pArray);
        
        int windowSize = p.length();
        
        // Step 2: Check each window of size p.length() in s
        for (int i = 0; i <= s.length() - windowSize; i++) {
            // Extract substring window
            String window = s.substring(i, i + windowSize);
            
            // Sort the current window
            char[] windowArray = window.toCharArray();
            Arrays.sort(windowArray);
            String sortedWindow = new String(windowArray);
            
            // Compare sorted strings - if equal, they're anagrams
            if (sortedWindow.equals(sortedP)) {
                result.add(i);
            }
        }
        
        return result;
    }
}
