/*
 * LC 36 — Valid Sudoku
 *
 * PROBLEM:
 * Determine if a 9×9 Sudoku board is valid based on these rules:
 * 1. Each row must contain digits 1-9 with no repetition
 * 2. Each column must contain digits 1-9 with no repetition
 * 3. Each of the nine 3×3 boxes must contain digits 1-9 with no repetition
 * Empty cells are marked '.' — only filled cells need validation.
 *
 * CONSTRAINTS:
 * - board.length == 9, board[i].length == 9
 * - board[i][j] is digit 1-9 or '.'
 * - Does NOT need to be solvable — just valid as filled so far
 *
 * KEY FORMULA — BOX INDEX:
 * Two directions of the same math:
 *
 * DIRECTION 1 — cell coordinates → box index (used in optimal):
 *   boxIndex = (row/3) * 3 + (col/3)
 *   row/3 → which row group    (0,1,2)
 *   col/3 → which col group    (0,1,2)
 *   multiply row group by 3 → offset, add col group → unique box index
 *
 * DIRECTION 2 — box index → starting coordinates (used in brute force):
 *   startRow = (b/3) * 3
 *   startCol = (b%3) * 3
 *   b/3 → which row group    → multiply by 3 → actual row start (0,3,6)
 *   b%3 → position within row group → multiply by 3 → actual col start (0,3,6)
 *
 * Example — b goes 0 to 8:
 * b=0: startRow=(0/3)*3=0, startCol=(0%3)*3=0 → top-left box
 * b=1: startRow=(1/3)*3=0, startCol=(1%3)*3=3 → top-middle box
 * b=2: startRow=(2/3)*3=0, startCol=(2%3)*3=6 → top-right box
 * b=3: startRow=(3/3)*3=3, startCol=(3%3)*3=0 → middle-left box
 * b=4: startRow=(4/3)*3=3, startCol=(4%3)*3=3 → middle-center box
 *
 * BOTH ARE INVERSE OF EACH OTHER:
 * Brute force: box index b → starting cell coordinates
 * Optimal:     cell coordinates (i,j) → box index
 * Same math, different direction.
 *
 * General pattern for any n×n grid with k×k boxes (k = √n):
 *   boxIndex = (row/k) * k + (col/k)  ← cell to box
 *   startRow = (b/k) * k              ← box to cell (row)
 *   startCol = (b%k) * k              ← box to cell (col)
 *
 * WHY THREE HashSet ARRAYS:
 * Three independent rules must be checked simultaneously.
 * rows[i]   → digits seen in row i
 * cols[j]   → digits seen in col j
 * boxes[b]  → digits seen in box b
 * Single set can't track all three rules independently.
 *
 * Set.add() TRICK:
 * add() returns false if element already exists.
 * !rows[i].add(c) → true when duplicate found → return false immediately.
 * Checks all three rules in one line with short-circuit OR.
 *
 * INITIALIZATION — outside double loop:
 * Must initialize all 9 HashSets BEFORE iterating board.
 * Initializing inside double loop recreates sets → loses seen digits!
 *
 * ALL APPROACHES:
 * ┌──────────────────┬──────────────────────────────────┬──────┬──────┐
 * │ Approach         │ Idea                             │ TC   │ SC   │
 * ├──────────────────┼──────────────────────────────────┼──────┼──────┤
 * │ Brute Force      │ Three separate passes            │ O(1) │ O(1) │
 * │ HashSet Arrays   │ Single pass, three sets          │ O(1) │ O(1) │
 * └──────────────────┴──────────────────────────────────┴──────┴──────┘
 *
 * NOTE: Both O(1) TC and SC — board is always fixed 9×9 = 81 cells.
 *
 * ─────────────────────────────────────────
 * APPROACH 1 — BRUTE FORCE (Three separate passes)
 * ─────────────────────────────────────────
 * WHY: Simplest — validate each rule independently.
 * HOW:
 * Pass 1 — check each row for duplicates
 * Pass 2 — check each col for duplicates
 * Pass 3 — check each 3×3 box for duplicates
 *
 * BOX TRAVERSAL — box index b → starting coordinates:
 * startRow = (b/3)*3  → b/3 gives row group, ×3 gives actual row start
 * startCol = (b%3)*3  → b%3 gives col position in row group, ×3 gives col start
 * Then iterate 3×3 from (startRow, startCol)
 *
 * TC: O(1) — fixed 81 cells × 3 passes = 243 operations
 * SC: O(1) — fixed size sets, max 9 elements each
 */
public boolean isValidSudokuBrute(char[][] board) {
    // pass 1 — check rows
    for(int i = 0; i < 9; i++){
        Set<Character> seen = new HashSet<>();
        for(int j = 0; j < 9; j++){
            if(board[i][j] == '.') continue;
            if(!seen.add(board[i][j])) return false;
        }
    }
    // pass 2 — check cols
    for(int j = 0; j < 9; j++){
        Set<Character> seen = new HashSet<>();
        for(int i = 0; i < 9; i++){
            if(board[i][j] == '.') continue;
            if(!seen.add(board[i][j])) return false;
        }
    }
    // pass 3 — check boxes
    for(int b = 0; b < 9; b++){
        Set<Character> seen = new HashSet<>();
        // box index → starting coordinates
        int startRow = (b/3)*3;  // b/3 = row group, ×3 = actual row start
        int startCol = (b%3)*3;  // b%3 = col position in group, ×3 = actual col start
        for(int i = startRow; i < startRow+3; i++)
            for(int j = startCol; j < startCol+3; j++){
                if(board[i][j] == '.') continue;
                if(!seen.add(board[i][j])) return false;
            }
    }
    return true;
}

/*
 * ─────────────────────────────────────────
 * APPROACH 2 — THREE HashSet ARRAYS (Optimal)
 * ─────────────────────────────────────────
 * WHY: Single pass — check all three rules simultaneously.
 * Cleaner and more efficient than three separate passes.
 *
 * HOW:
 * Declare rows[], cols[], boxes[] — each array of 9 HashSets.
 * Initialize all 27 sets before iterating.
 * For each cell (i,j):
 *   skip '.'
 *   compute boxIndex = (i/3)*3 + (j/3)  ← cell coordinates → box index
 *   try add to rows[i], cols[j], boxes[boxIndex]
 *   any add() returns false → duplicate → return false
 *
 * BOX FORMULA — cell coordinates → box index:
 * (i/3) → row group (0,1,2)
 * (j/3) → col group (0,1,2)
 * (i/3)*3 + (j/3) → unique box index 0-8
 *
 * SHORT CIRCUIT OR:
 * !rows[i].add(c) || !cols[j].add(c) || !boxes[b].add(c)
 * If rows check fails → cols and boxes not even checked.
 * Stops at first duplicate found.
 *
 * Dry run — board[0][0]='5', board[0][3]='5':
 * (0,0): box=(0/3)*3+(0/3)=0
 *        rows[0].add('5')→true ✅
 *        cols[0].add('5')→true ✅
 *        boxes[0].add('5')→true ✅ → continue
 * (0,3): box=(0/3)*3+(3/3)=1
 *        rows[0].add('5')→FALSE! → return false ✅
 *
 * TC: O(1) — fixed 81 cells, single pass
 * SC: O(1) — 27 sets, each max 9 elements = 243 entries max
 *
 * Edge cases:
 * - All '.' → no checks → return true ✅
 * - Same digit in same box different row/col → boxes catches it ✅
 * - Valid complete board → all adds succeed → return true ✅
 */
public boolean isValidSudoku(char[][] board) {
    Set<Character>[] rows  = new HashSet[9];
    Set<Character>[] cols  = new HashSet[9];
    Set<Character>[] boxes = new HashSet[9];
    // initialize all sets — MUST be outside double loop
    for(int i = 0; i < 9; i++){
        rows[i]  = new HashSet<>();
        cols[i]  = new HashSet<>();
        boxes[i] = new HashSet<>();
    }
    for(int i = 0; i < 9; i++){
        for(int j = 0; j < 9; j++){
            if(board[i][j] == '.') continue;
            char c = board[i][j];
            // cell coordinates → box index
            int boxIndex = (i/3)*3 + (j/3);
            // add() returns false if duplicate → invalid board
            if(!rows[i].add(c) || !cols[j].add(c) || !boxes[boxIndex].add(c))
                return false;
        }
    }
    return true;
}
