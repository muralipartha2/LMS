/*
 * LC 219 — Contains Duplicate II
 *
 * PROBLEM:
 * Given integer array nums and integer k, return true if there exist
 * two indices i and j such that:
 *   - nums[i] == nums[j]
 *   - abs(i - j) <= k
 *
 * CONSTRAINTS:
 * - 1 <= nums.length <= 10^5
 * - -10^9 <= nums[i] <= 10^9
 * - 0 <= k <= 10^5
 *
 * KEY DIFFERENCE FROM LC 217:
 * LC 217 — just find any duplicate, indices don't matter
 * LC 219 — duplicate pair must be within a window of size k
 * Indices are part of the answer → sorting destroys them → sorting rejected
 *
 * EDGE CASES:
 * k == 0:
 *   abs(i-j) <= 0 with i != j is impossible
 *   two different indices can never have distance 0 → always false
 *
 * nums.length == 1:
 *   NOT needed as explicit check — loop naturally returns false
 *   single element has no pair to compare against
 *
 * ALL APPROACHES:
 * ┌────────────────┬──────────────────────────────┬───────┬──────┐
 * │ Approach       │ Idea                         │ TC    │ SC   │
 * ├────────────────┼──────────────────────────────┼───────┼──────┤
 * │ Brute Force    │ Nested loop, check every pair│ O(n²) │ O(1) │
 * │ HashMap        │ value → latest index         │ O(n)  │ O(n) │
 * ├────────────────┼──────────────────────────────┼───────┼──────┤
 * │ Sorting        │ REJECTED — destroys indices  │  —    │  —   │
 * └────────────────┴──────────────────────────────┴───────┴──────┘
 *
 * ─────────────────────────────────────────
 * APPROACH 1 — BRUTE FORCE
 * ─────────────────────────────────────────
 * WHY: Simplest — check every pair (i, j) where j > i.
 * HOW: For each i, scan all j from i+1.
 *      If values equal AND index diff <= k → return true.
 *
 * OPTIMIZATION INSIDE BRUTE FORCE:
 * Inner loop can break early when j - i > k
 * No point scanning further — diff will only grow larger.
 *
 * TC: O(n*k) with early break, O(n²) worst case (k >= n)
 * SC: O(1) — no extra space
 */
public boolean containsNearbyDuplicateBrute(int[] nums, int k) {
    if (k == 0) return false;
    for (int i = 0; i < nums.length; i++) {
        // j starts at i+1, break when distance exceeds k
        for (int j = i + 1; j < nums.length; j++) {
            if (j - i > k) break; // no point going further
            if (nums[i] == nums[j]) return true;
        }
    }
    return false;
}

/*
 * ─────────────────────────────────────────
 * APPROACH 2 — HASHMAP (Optimal)
 * ─────────────────────────────────────────
 * WHY HashMap over HashSet:
 * We need to store both the value AND its last seen index.
 * HashSet stores only values — no index information.
 * HashMap<value, lastSeenIndex> gives O(1) lookup of both.
 *
 * HOW:
 * Single pass. For each index i:
 *   - containsKey(nums[i])? → duplicate candidate found
 *       → check if i - prevIndex <= k → return true
 *   - Always update map.put(nums[i], i) unless we returned true
 *
 * WHY ALWAYS UPDATE INDEX:
 * When diff > k, we must update to latest index.
 * Keeping stale index gives wrong diff for future duplicates.
 * Example: [1,2,3,1,1], k=1
 *   i=3: see 1 again, prevIndex=0, diff=3 > 1 → update index to 3
 *   i=4: see 1 again, prevIndex=3, diff=1 <= 1 → return true ✅
 *   If we kept index=0: diff=4 > 1 → wrong answer ❌
 *
 * WHY containsKey not containsValue:
 * containsKey  → O(1) — hash finds bucket directly
 * containsValue → O(n) — must scan all entries, no hashing on values
 * We key by array value → containsKey is correct choice.
 *
 * COLLAPSED put() — clean pattern:
 * map.put() always runs (updates OR inserts) except on return true.
 * No need for separate if/else branches for put.
 *
 * TC: O(n)  — single pass, O(1) per containsKey/get/put
 * SC: O(n)  — worst case all elements in map (all unique values)
 *
 * Best case:  O(1) — duplicate within k at index 0,1
 * Worst case: O(n) — no valid pair found, full scan
 *
 * Dry run — nums=[1,2,3,1,2,3], k=2:
 * i=0: no key 1 → put(1,0) → {1→0}
 * i=1: no key 2 → put(2,1) → {1→0,2→1}
 * i=2: no key 3 → put(3,2) → {1→0,2→1,3→2}
 * i=3: key 1 found, prev=0, diff=3>2 → update put(1,3) → {1→3,2→1,3→2}
 * i=4: key 2 found, prev=1, diff=3>2 → update put(2,4) → {1→3,2→4,3→2}
 * i=5: key 3 found, prev=2, diff=3>2 → update put(3,5)
 * return false ✅
 */
public boolean containsNearbyDuplicate(int[] nums, int k) {
    if (k == 0) return false;
    Map<Integer, Integer> map = new HashMap<>();
    for (int i = 0; i < nums.length; i++) {
        if (map.containsKey(nums[i])) {
            int prevIndex = map.get(nums[i]);
            // check distance constraint
            if (i - prevIndex <= k) return true;
        }
        // always update — latest index gives best chance for future matches
        map.put(nums[i], i);
    }
    return false;
}
