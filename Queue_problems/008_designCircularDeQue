// one edge case that we need to handle here is rear being -1 during initialization
// so extra care is needed in offerFirst method to make it a proper circular array
// pointing first and last index to the same element. 

class MyCircularDeque {
    private int[] arr;
    private int front;
    private int rear;
    private int size;
    private int capacity;

    public MyCircularDeque(int k) {
        this.arr=new int[k];
        this.capacity= k;
        this.front=0;
        this.rear=-1;
        this.size=0;
    }

    public boolean insertFront(int value) {
        if(isFull())
        return false;
        front=(front - 1 + capacity)%capacity;
        arr[front]=value;
        if(size == 0) rear = front;
        size++;
        return true;        
    }
    
    public boolean insertLast(int value) {
        if(isFull())
        return false;
        rear= (rear+1) % capacity;
        arr[rear]=value;
        size++;
        return true;
    }

    public boolean deleteFront() {
        if(isEmpty())
            return false;
        
        int val=arr[front];
        arr[front]=-1;
        front=(front +1) % capacity;
        size--;
        return true;
    }
    
    public boolean deleteLast() {
        if(isEmpty())
            return false;
        
        int val=arr[rear];
        arr[rear]=-1;
        rear=(rear - 1 + capacity) % capacity;
        size--;
        return true;
    }

    public int getFront() {
        if(isEmpty())
            return -1;
        return arr[front];        
    }
    
    public int getRear() {
        if(isEmpty())
            return -1;
        return arr[rear];
    }

    public boolean isEmpty() {
        return size == 0;
    }
    
    public boolean isFull() {
        return size == capacity;
    }
}

