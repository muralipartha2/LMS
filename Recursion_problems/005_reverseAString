/**
 * LC 344 - Reverse String
 * Difficulty: Easy
 * Topic: Recursion (Linear on string) — Two Pointer + Recursion
 *
 * CONSTRAINTS:
 * - In-place — no extra array allowed
 * - Must use O(1) extra memory (excluding recursion stack)
 *
 * =====================================================================
 * APPROACH 1 — Iterative Two Pointer
 * =====================================================================
 * WHY: Simplest, O(1) space, no stack risk.
 * HOW: Swap from both ends moving inward until start >= end.
 * TC: O(n) | SC: O(1)
 */
public void reverseStringIterative(char[] s) {
    int start = 0, end = s.length - 1;
    while (start < end) {
        char temp = s[start];
        s[start] = s[end];
        s[end] = temp;
        start++;
        end--;
    }
}

/**
 * =====================================================================
 * APPROACH 2 — Recursive Two Pointer
 * =====================================================================
 * WHY: Same two pointer idea but using recursion instead of a loop.
 *      Shows how iteration and recursion are interchangeable.
 * HOW: Swap first and last characters, recurse on middle portion.
 *      Base case: start >= end — window exhausted, stop.
 *      LC signature has single input — use private helper with start/end.
 *
 * KEY INSIGHT:
 * - Only ONE recursive call per level — not two.
 *   We swap two elements but recurse only once into the smaller middle.
 * - Window shrinks by 2 each call (start+1, end-1) → n/2 total calls.
 *   O(n/2) = O(n) TC and SC.
 *
 * COMMON MISTAKE: Thinking SC is O(1) because swap is in-place.
 *   Swap IS in-place but recursion still creates n/2 stack frames → O(n) SC.
 *
 * TC: O(n) — n/2 recursive calls
 * SC: O(n) — n/2 stack frames alive at peak depth
 */
public void reverseString(char[] s) {
    reverse(s, 0, s.length - 1);
}

private void reverse(char[] s, int start, int end) {
    if (start >= end) return;       // base case — window exhausted
    char temp = s[start];           // swap first and last
    s[start] = s[end];
    s[end] = temp;
    reverse(s, start + 1, end - 1); // recurse on middle portion
}
