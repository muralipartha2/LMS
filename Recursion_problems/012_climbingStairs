/**
 * LC 70 - Climbing Stairs
 * Difficulty: Easy
 * Topic: Recursion (Binary) + Memoization
 *
 * PROBLEM:
 * You can climb 1 or 2 steps at a time.
 * How many distinct ways to reach stair n?
 *
 * KEY INSIGHT:
 * To reach stair n, you either came from:
 *   - stair n-1 (took 1 step) OR
 *   - stair n-2 (took 2 steps)
 * So ways(n) = ways(n-1) + ways(n-2) → identical to Fibonacci!
 *
 * FOLLOW-UP INSIGHT (interview question):
 * If you can take 1, 2, or 3 steps:
 *   ways(n) = ways(n-1) + ways(n-2) + ways(n-3) → Tribonacci!
 * Generally for k steps: sum of previous k values → k-bonacci
 *
 * =====================================================================
 * APPROACH 1 — Naive Recursive (Binary Recursion)
 * =====================================================================
 * WHY: Direct translation of recurrence relation.
 * HOW: Two recursive calls per level — same as Fibonacci naive.
 *
 * PROBLEM: Overlapping subproblems — climbStairs(3) computed multiple
 *   times. Gets TLE on LeetCode for large n. Proven experimentally!
 *
 * TC: O(2^n) — binary recursion tree, n levels deep
 * SC: O(n) — maximum stack depth at any moment
 */
public int climbStairsNaive(int n) {
    if (n <= 2) return n;
    return climbStairsNaive(n - 1) + climbStairsNaive(n - 2);
}

/**
 * =====================================================================
 * APPROACH 2 — Memoized Recursive (Top Down)
 * =====================================================================
 * WHY: Naive gets TLE — same subproblems computed millions of times.
 *      Memo stores results — each value computed exactly once.
 * HOW: Check memo before computing.
 *      Store result in memo before returning.
 *      Same memo object passed to all recursive calls — not recreated!
 *
 * COMMON MISTAKE: Thinking memo creates a new HashMap every recursive
 *   call. It doesn't — created ONCE in climbStairs(), same object
 *   reference passed around. Java passes objects by reference.
 *
 * TC: O(n) — each value computed exactly once
 * SC: O(n) — memo map + stack depth
 */
public int climbStairs(int n) {
    Map<Integer, Integer> memo = new HashMap<>();  // created ONCE
    return recursive(n, memo);
}

private int recursive(int n, Map<Integer, Integer> memo) {
    if (n <= 2) return n;
    if (memo.containsKey(n)) return memo.get(n);   // already computed
    int result = recursive(n - 1, memo) + recursive(n - 2, memo);
    memo.put(n, result);                            // store before returning
    return result;
}

/**
 * =====================================================================
 * APPROACH 3 — Iterative (Bottom Up)
 * =====================================================================
 * WHY: Best for production. O(1) space, no recursion, no TLE risk.
 * HOW: Track only last two values — lastBefore and last.
 *      Each iteration: currentStep = last + lastBefore
 *      Slide window forward.
 *
 * BASE CASE: n<=2 handled separately before loop.
 *   Loop starts from i=3 since n=1 and n=2 already returned.
 *   Loop condition i<=n NOT currentStep<n —
 *   currentStep is number of WAYS not stair number!
 *
 * TC: O(n) | SC: O(1)
 */
public int climbStairsIterative(int n) {
    if (n <= 2) return n;
    int lastBefore = 1;   // ways to reach stair 1
    int last = 2;         // ways to reach stair 2
    int currentStep = 0;
    for (int i = 3; i <= n; i++) {
        currentStep = last + lastBefore;  // ways(n) = ways(n-1) + ways(n-2)
        lastBefore = last;                // slide window forward
        last = currentStep;
    }
    return currentStep;
}
