// LC 704 — Binary Search
// Problem: Given a sorted array of distinct integers, return index of target or -1
// Key insight: Sorted array — eliminate half the search space every step
//
// ─────────────────────────────────────────────────────────────────
// OPTIMAL — O(log n) time, O(1) space
// WHY: Array is sorted — no need to scan every element linearly
// HOW: Maintain lo/hi boundaries, compute mid, eliminate half each step
// ─────────────────────────────────────────────────────────────────
class Solution {
    public int search(int[] nums, int target) {

        // initialize search boundaries
        int lo = 0, hi = nums.length - 1;

        while (lo <= hi) {
            // safe mid — avoids int overflow
            int mid = lo + (hi - lo) / 2;

            if (nums[mid] == target) {
                return mid;              // found — return index
            } else if (nums[mid] < target) {
                lo = mid + 1;            // target in right half
            } else {
                hi = mid - 1;            // target in left half
            }
        }

        return -1;                       // search space exhausted
    }
}
